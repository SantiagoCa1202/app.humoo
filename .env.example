EXPO_PUBLIC_ANDROID_PACKAGE=com.humoo.client

# Local-only examples. Put staging/production values in protected build envs.
MYSQL_DATABASE=humoo
MYSQL_USER=humoo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
