APP_NAME=Humoo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8081
FRONTEND_URLS=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=humoo
DB_USERNAME=humoo
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:8081,127.0.0.1:8081

# Use pusher in an environment with a configured Reverb/Pusher server.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
FILESYSTEM_DISK=local
FILESYSTEM_SERVE=true
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@humoo.ai"
MAIL_FROM_NAME="${APP_NAME}"

# AI is server-side only. With the canonical tool loop enabled, the model
# selects registered tools and the backend validates and executes them safely.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=30
AI_MAX_ORCHESTRATION_ITERATIONS=5
AI_MAX_TOOL_CALLS_PER_TURN=4
AI_PROMPT_VERSION=humoo-chat-v1
# Legacy V2 switch retained as a compatibility alias for the canonical loop.
AI_FUNCTION_CALLING_V2=false
# Enables the canonical AIOrchestrator -> ToolRegistry -> ToolExecutor loop.
# Keep false until the compatible runtime E2E checks are available.
AI_TOOL_LOOP_ENABLED=false
AI_ROUTING_LOCAL_ENABLED=false
AI_RULE_BASED_MODEL=humoo-rule-based

# Optional hosted billing provider. Leave unset until provider credentials/webhooks exist.
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Production mail must use a transactional provider, not log/array.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

VITE_APP_NAME="${APP_NAME}"
