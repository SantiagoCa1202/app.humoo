{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humoo.local/contracts/beo-extraction/v1/extraction-job.schema.json",
  "title": "Humoo BEO Extraction Job V1",
  "type": "object",
  "required": ["schema_version", "extraction_run_id", "document_id", "import_batch_id", "correlation_id", "document", "options", "requested_at"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "extraction_run_id": {"$ref": "shared.schema.json#/$defs/id"},
    "document_id": {"$ref": "shared.schema.json#/$defs/id"},
    "import_batch_id": {"$ref": "shared.schema.json#/$defs/nullableString"},
    "correlation_id": {"$ref": "shared.schema.json#/$defs/id"},
    "document": {
      "type": "object",
      "required": ["filename", "mime_type", "sha256", "file_size", "source_reference", "provider_hint", "language_hints"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "mime_type": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "file_size": {"type": ["integer", "null"], "minimum": 0},
        "source_reference": {"$ref": "shared.schema.json#/$defs/nullableString"},
        "provider_hint": {"$ref": "shared.schema.json#/$defs/nullableString"},
        "language_hints": {"type": ["array", "null"], "items": {"type": "string", "minLength": 2}},
        "extensions": {"$ref": "shared.schema.json#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "required": ["use_ocr", "include_layout", "include_source_trace", "parser_profile"],
      "properties": {
        "use_ocr": {"type": "boolean"},
        "include_layout": {"type": "boolean"},
        "include_source_trace": {"type": "boolean"},
        "parser_profile": {"$ref": "shared.schema.json#/$defs/nullableString"},
        "extensions": {"$ref": "shared.schema.json#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "requested_at": {"type": "string", "format": "date-time"},
    "extensions": {"$ref": "shared.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false
}
